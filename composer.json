{
  "name": "phore/hydrator",
  "description": "Unserialize arrays into object structure",
  "license": "MIT",
  "authors": [
    { "name": "Matthias Leuffen", "email": "m@tth.es" }
  ],
  "require": {
    "php": ">=7.2",
    "phore/core": "*"
  },

  "suggest": {
  },
  "autoload": {
    "psr-4": {
      "Phore\\Hydrator\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "phpspec/phpspec": "^8.3"
  },
  "scripts": {
    "test": "phpspec run --no-interaction"
  }
}
